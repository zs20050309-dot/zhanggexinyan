ANTHROPIC_API_KEY=sk-ant-your-key-here
# 中转API时填写，官方直连时留空或删除此行
ANTHROPIC_BASE_URL=https://your-relay.example.com

# OpenAI Whisper（ASR 视频转文字）—— 多数中转和 Anthropic 共用一把 key
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://your-relay.example.com

TAVILY_API_KEY=tvly-your-key-here

# ── 抖音解析（中国大陆 + VPN 分流）────────────────────────
#
# 场景：Claude Code 需 VPN；抖音必须直连才能下字幕/ASR
#
# 【VPN 开着 · 仅元数据/描述文案】
# DOUYIN_NETWORK_MODE=auto
# SKIP_ASR=true
#
# 【关 VPN · 直连抖音 · 字幕/ASR】
# DOUYIN_NETWORK_MODE=direct
# DOUYIN_ALWAYS_PROBE_DIRECT=true
# 去掉 SKIP_ASR，配置 OPENAI_API_KEY
# 关 VPN 后先: curl http://localhost:8000/api/video/ping
#
# 【长期方案 · VPN 开着也能直连抖音】Clash 规则把 douyin.com → DIRECT
# DOUYIN_NETWORK_MODE=direct
# DOUYIN_ALWAYS_PROBE_DIRECT=true
#
# DOUYIN_PROXY=          # 一般不要设；抖音走直连，不要走 VPN 代理
# DOUYIN_FALLBACK_API=https://api.xingzhige.com/API/douyin/
