ANTHROPIC_API_KEY=sk-ant-your-key-here
# 中转API时填写，官方直连时留空或删除此行
ANTHROPIC_BASE_URL=https://your-relay.example.com

# OpenAI Whisper（ASR 视频转文字）—— 多数中转和 Anthropic 共用一把 key
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://your-relay.example.com

TAVILY_API_KEY=tvly-your-key-here

# 抖音解析（可选）
# 系统代理(Clash等)导致 v.douyin.com TLS 失败时，代码已默认 bypass 系统代理(trust_env=False)
# 若需走代理访问抖音，设置本地代理地址，例如：
# DOUYIN_PROXY=http://127.0.0.1:7890
# 跳过视频下载+Whisper，仅用视频描述文字（更快，适合网络差时）：
# SKIP_ASR=true
# 直连抖音失败时的备用解析 API（默认 api.xingzhige.com）
# DOUYIN_FALLBACK_API=https://api.xingzhige.com/API/douyin/
